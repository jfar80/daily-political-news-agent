# ===== Anthropic API =====
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxx
# Modelo a usar. Opciones recomendadas: claude-sonnet-4-6 (default, balance) | claude-opus-4-7 (máxima calidad)
ANTHROPIC_MODEL=claude-sonnet-4-6

# ===== APIs públicas de medios (opcionales, todas gratis) =====
# Si se definen, el agente las usa para cargar titulares primarios antes de llamar a Claude.
# Si se dejan vacías, el agente igual funciona — solo depende de RSS y web_search.

# NYT Developer API — gratis en https://developer.nytimes.com/ (4000 req/día)
NYT_API_KEY=

# The Guardian Open Platform — gratis en https://open-platform.theguardian.com/ (12000 req/día)
GUARDIAN_API_KEY=

# ===== Destinatario del correo (parametrizable) =====
EMAIL_TO=destinatario@ejemplo.com

# ===== Configuración SMTP =====
# Ejemplo Gmail: usar contraseña de aplicación (https://myaccount.google.com/apppasswords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=tu_correo@gmail.com
SMTP_PASS=xxxx_xxxx_xxxx_xxxx
SMTP_FROM="Agente Político <tu_correo@gmail.com>"

# ===== Cron =====
# Hora de ejecución en zona horaria America/Bogota (UTC-5, sin horario de verano)
CRON_EXPRESSION=0 6 * * *
TIMEZONE=America/Bogota

# ===== Depuración =====
# Si es true, ejecuta un informe apenas arranca (útil en pruebas)
RUN_ON_START=false
