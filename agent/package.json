{
  "name": "political-news-agent",
  "version": "1.0.0",
  "description": "Agente diario de investigación política: genera un informe HTML y lo envía por correo a las 6:00 AM hora Colombia.",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "run-once": "tsx src/run-once.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.32.1",
    "dotenv": "^16.4.5",
    "node-cron": "^3.0.3",
    "nodemailer": "^8.0.5",
    "rss-parser": "^3.13.0"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^6.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20"
  }
}
